<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#00FFFFFF"
    android:gravity="center"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/shape_posts_container"
            android:backgroundTint="@color/bgBlue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/textView32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Verify your profile!"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView33"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="30dp"
                android:gravity="center"
                android:text="Verify your proficiency by submitting 3 images of your angling certifications. All submitted images will then be processed by our team!"
                android:textColor="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView32" />

            <LinearLayout
                android:id="@+id/linearLayout17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/shape_dialog_container"
                android:backgroundTint="#00FFFFFF"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@+id/linearLayout18"
                app:layout_constraintEnd_toEndOf="@+id/textView33"
                app:layout_constraintStart_toStartOf="@+id/textView33"
                app:layout_constraintTop_toBottomOf="@+id/textView33">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgOne"
                    android:layout_width="280px"
                    android:layout_height="280px"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="15dp"
                    android:background="@color/bgBlue"
                    android:clickable="true"
                    android:src="@drawable/baseline_add_24"
                    app:shapeAppearanceOverlay="@style/rounded10dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgTwo"
                    android:layout_width="280px"
                    android:layout_height="280px"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="15dp"
                    android:background="@color/bgBlue"
                    android:clickable="true"
                    android:src="@drawable/baseline_add_24"
                    app:shapeAppearanceOverlay="@style/rounded10dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgThree"
                    android:layout_width="280px"
                    android:layout_height="280px"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="15dp"
                    android:background="@color/bgBlue"
                    android:clickable="true"
                    android:src="@drawable/baseline_add_24"
                    app:shapeAppearanceOverlay="@style/rounded10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:backgroundTint="@color/white"
                    android:text="Cancel"
                    android:textColor="@color/bgBlue" />

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/iconBlue"
                    android:text="Submit"
                    android:textColor="@color/white" />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="500px"
            android:layout_height="500px"
            android:layout_marginBottom="-40dp"
            android:src="@drawable/shark"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayout9"
            app:layout_constraintEnd_toEndOf="@+id/constraintLayout9"
            app:layout_constraintHorizontal_bias="0.49"
            app:layout_constraintStart_toStartOf="@+id/constraintLayout9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>